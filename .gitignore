**/node_modules/

# Ignore node_modules folder everywhere
/*/node_modules/

# Ignore build or dist folders (commonly generated files)
dist/
build/

# Ignore environment files (e.g., sensitive info or config)
.env
.env.local
# Ignore Next.js specific files and folders
**/.next/
**/out/
*/out/
*/.next/
*/*/.next
*/*/*/.next
# Ignore logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore specific files or folders in react-course folder
react-course/react-basics/node_modules/
react-course/react-hooks/node_modules/
react-course/**/dist/

# Ignore editor and OS-specific files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ignore temporary files
*.tmp
*.swp
*.bak

# Ignore Git merge conflict files
*.orig
